@mode(host.dual)

# Tests for which's exit statuses, through cli.app.run with whole command
# lines. These tests print the program's normal output and error messages,
# and use tests/fixtures/, so run them from the repository root.
#
# Runtime: host.dual, run by the test runner: `make test` interprets this file
# with Stage0 (`loup-bootstrap test`, source/ on LOUPPATH), one test per
# `func test_*()`. It is not part of the binary.

from debug.assert import (expectEq);
from appinfo import (EXIT_OK, EXIT_FAILURE, EXIT_USAGE);
from cli.app import (run);

func test_version_succeeds(): void {
    expectEq(run(["--version"]), EXIT_OK, "--version");
}

func test_help_succeeds(): void {
    expectEq(run(["--help"]), EXIT_OK, "--help");
}

func test_name_with_slash_succeeds(): void {
    expectEq(run(["tests/fixtures/bin1/tool"]), EXIT_OK, "path to a file");
}

func test_missing_name_fails(): void {
    expectEq(run(["-s", "tests/fixtures/bin1/nope"]), EXIT_FAILURE, "missing");
}

func test_invalid_option_is_usage_error(): void {
    expectEq(run(["-x"]), EXIT_USAGE, "-x");
}
