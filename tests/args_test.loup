@mode(host.dual)

from debug.assert import (expect, expectEq);
from cli.args import (parse_args);

func test_no_arguments(): void {
    let none: list[string] = [];
    let opts = parse_args(none).unwrap();
    expectEq(opts.names.len(), 0, "no names");
    expect(!opts.all and !opts.silent and !opts.help and !opts.version, "no flags");
}

func test_options_and_names(): void {
    let opts = parse_args(["-a", "-s", "ls", "cat"]).unwrap();
    expect(opts.all and opts.silent, "-a -s");
    expectEq(opts.names.len(), 2, "two names");
    expectEq(opts.names[1], "cat", "order kept");
}

func test_combined_options(): void {
    let opts = parse_args(["-sa", "ls"]).unwrap();
    expect(opts.all and opts.silent, "-sa");
}

func test_options_stop_at_first_name(): void {
    let opts = parse_args(["ls", "-a"]).unwrap();
    expect(!opts.all, "-a after a name is a name");
    expectEq(opts.names[1], "-a", "literal -a");
}

func test_double_dash_and_lone_dash(): void {
    let opts = parse_args(["--", "-a"]).unwrap();
    expect(!opts.all, "-a after -- is a name");
    expectEq(opts.names[0], "-a", "name");
    expectEq(parse_args(["-"]).unwrap().names[0], "-", "lone dash is a name");
}

func test_invalid_options(): void {
    expectEq(parse_args(["-x", "ls"]).unwrap_err(), "invalid option -- 'x'", "-x");
    expectEq(parse_args(["-ax"]).unwrap_err(), "invalid option -- 'x'", "-ax");
    expectEq(parse_args(["--all"]).unwrap_err(), "unrecognized option '--all'", "--all");
}

func test_help_and_version(): void {
    expect(parse_args(["--help"]).unwrap().help, "--help");
    expect(parse_args(["--version"]).unwrap().version, "--version");
}
