@mode(host.dual)

# Command-line parsing for which, following the shell's getopts as the
# debianutils script uses it: single-letter options `a` and `s`, combinable
# (`-as`), parsed only until the first argument that is not an option; `--`
# ends the options. `--help` and `--version` are accepted in the same place.

pub struct Options {
    pub help: bool;
    pub version: bool;
    # -a: print every match on PATH, not just the first.
    pub all: bool;
    # -s: print nothing; report only through the exit status.
    pub silent: bool;
    pub names: list[string];
}

pub func parse_args(argv: list[string]): Result[Options, string] {
    var help = false;
    var version = false;
    var all = false;
    var silent = false;

    var i = 0;
    while (i < argv.len()) {
        let arg = argv[i];
        if (arg == "--") {
            i += 1;
            break;
        }
        if (arg == "-" or !arg.startsWith("-")) {
            break;
        }
        i += 1;
        if (arg == "--help") {
            help = true;
            continue;
        }
        if (arg == "--version") {
            version = true;
            continue;
        }
        if (arg.startsWith("--")) {
            return Err(i"unrecognized option '{$ arg $}'");
        }
        for (ch in arg.slice(1)) {
            if (ch == "a") {
                all = true;
            } else if (ch == "s") {
                silent = true;
            } else {
                return Err(i"invalid option -- '{$ ch $}'");
            }
        }
    }

    return Ok(Options(
        help = help,
        version = version,
        all = all,
        silent = silent,
        names = argv.slice(i),
    ));
}
