@mode(host.dual)

# Help and version text for which: usage() is printed by --help,
# version_line() by --version.
#
# Runtime: host.dual. Compiled into the native binary build/which by
# `make build`; `loup run source/main.loup` interprets the same code.

from appinfo import (APP_NAME, APP_VERSION);

pub func usage(): string {
    let lines = [
        i"Usage: {$ APP_NAME $} [-as] [--] NAME...",
        "Print the full path of each NAME that would be run as a command,",
        "searching the directories in PATH in order.",
        "",
        "  -a             print all matching paths, not just the first",
        "  -s             silent: print nothing, only set the exit status",
        "      --help     display this help and exit",
        "      --version  output version information and exit",
        "",
        "A NAME containing a slash is checked as it is, without searching PATH.",
        "An empty entry in PATH means the current directory.",
        "",
        "Exit status:",
        " 0  if every NAME was found,",
        " 1  if some NAME was not found, or no NAME was given,",
        " 2  if an option is invalid.",
    ];
    return lines.join("\n");
}

pub func version_line(): string {
    return i"{$ APP_NAME $} (loup-cmd-{$ APP_NAME $}) {$ APP_VERSION $}";
}
